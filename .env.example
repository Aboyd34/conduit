# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
ALLOWED_ORIGIN=http://localhost:5173

# ─── AI ───────────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_key_here

# ─── OnchainKit / Wallet ──────────────────────────────────────────────────────
VITE_ONCHAINKIT_API_KEY=your_coinbase_developer_platform_key

# ─── Aether Contract ──────────────────────────────────────────────────────────
# Set this after running: npx hardhat run scripts/deploy-aether.js --network base-sepolia
VITE_AETHER_ADDRESS=

# ─── Hardhat / Deploy ─────────────────────────────────────────────────────────
# Private key of the deployer wallet (0x prefixed). Never share this.
DEPLOYER_KEY=0x_your_private_key_here

# Allocation wallets (can all be the same wallet for testing)
TEAM_WALLET=0x_your_team_wallet
LIQUIDITY_WALLET=0x_your_liquidity_wallet
TREASURY_WALLET=0x_your_treasury_wallet
ECOSYSTEM_WALLET=0x_your_ecosystem_wallet

# Merkle root from airdrop-snapshot.js output
MERKLE_ROOT=

# Basescan API key (for contract verification)
BASESCAN_API_KEY=your_basescan_api_key

# Optional: override default RPC
BASE_RPC_URL=https://mainnet.base.org
