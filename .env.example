# ─────────────────────────────────────────────
#  CONDUIT — Environment Variables
#  Copy this file to .env and fill in your values
#  NEVER commit your real .env to GitHub
# ─────────────────────────────────────────────

# ── APP ─────────────────────────────────────
NODE_ENV=development
ALLOWED_ORIGIN=http://localhost:5173

# ── BACKEND / SERVER ─────────────────────────
PORT=3001
JWT_SECRET=super_secret_jwt_key_change_me
MONGODB_URI=mongodb://localhost:27017/conduit

# ── AI ───────────────────────────────────────
GROQ_API_KEY=gsk_your_key_here

# ── FRONTEND / VITE (exposed to browser) ───────────
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001
VITE_CHAIN_ID=11155111

# Deployed Aether contract address (fill in after deploy step)
VITE_AETHER_ADDRESS=
VITE_ONCHAINKIT_API_KEY=your_coinbase_developer_platform_key

# ── HARDHAT / DEPLOY ─────────────────────────
# Deployer wallet private key (WITH 0x prefix)
DEPLOYER_KEY=0x_your_private_key_here

# Allocation wallets (can all be same wallet for testing)
TEAM_WALLET=0x_your_team_wallet
LIQUIDITY_WALLET=0x_your_liquidity_wallet
TREASURY_WALLET=0x_your_treasury_wallet
ECOSYSTEM_WALLET=0x_your_ecosystem_wallet

# Sepolia RPC — get free at https://alchemy.com or https://infura.io
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Base RPC
BASE_RPC_URL=https://mainnet.base.org

# Contract verification API keys
ETHERSCAN_API_KEY=your_etherscan_api_key
BASESCAN_API_KEY=your_basescan_api_key

# Merkle root output from airdrop-snapshot.js
MERKLE_ROOT=

# Deployed contract address (fill in after deploy)
AETHER_CONTRACT_ADDRESS=
