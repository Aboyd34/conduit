# ============================
# Conduit Environment Variables
# Copy this to .env and fill in values
# NEVER commit .env to git
# ============================

# --- Frontend (Vite) ---
# CDT Token contract address on Base Sepolia
VITE_CDT_TOKEN_ADDRESS=0x719d3f3E01E365F9aa73374674499539fdD0f82E

# Chain ID (84532 = Base Sepolia, 8453 = Base Mainnet)
VITE_CHAIN_ID=84532

# RPC URL
VITE_RPC_URL=https://sepolia.base.org

# WalletConnect Project ID (get from https://cloud.walletconnect.com)
VITE_WALLETCONNECT_PROJECT_ID=your_project_id_here

# Coinbase/OnchainKit API Key (get from https://portal.cdp.coinbase.com)
VITE_COINBASE_API_KEY=your_coinbase_api_key_here

# --- Backend (Express) ---
PORT=3001
NODE_ENV=development

# CORS - frontend URL
CORS_ORIGIN=http://localhost:5173

# --- Email (Resend) ---
RESEND_API_KEY=your_resend_api_key_here

# --- Hardhat Deployment ---
# Private key for contract deployment (NO 0x prefix needed)
DEPLOYER_KEY=your_wallet_private_key_here

# RPC URLs for Hardhat
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
SEPOLIA_RPC_URL=https://rpc.sepolia.org
BASE_RPC_URL=https://mainnet.base.org

# Etherscan API key for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key_here
